{
  "color": {
    "accent": {
      "$type": "color",
      "default": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.11, 155] } },
      "hover": { "$value": { "colorSpace": "oklch", "components": [0.85, 0.1, 155] } },
      "active": { "$value": { "colorSpace": "oklch", "components": [0.74, 0.11, 155] } }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "#/color/gray/950/$value" } }
  },
  "fernway": {
    "hero": {
      "bg": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.27, 0.04, 155] } },
      "fg": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.92, 0.05, 150] } }
    }
  }
}
