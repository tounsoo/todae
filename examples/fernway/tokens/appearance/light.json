{
  "color": {
    "accent": {
      "$type": "color",
      "default": { "$value": { "colorSpace": "oklch", "components": [0.44, 0.1, 155] } },
      "hover": { "$value": { "colorSpace": "oklch", "components": [0.39, 0.1, 155] } },
      "active": { "$value": { "colorSpace": "oklch", "components": [0.34, 0.09, 155] } }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "#/color/gray/0/$value" } }
  },
  "fernway": {
    "hero": {
      "bg": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.93, 0.04, 150] } },
      "fg": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.3, 0.07, 155] } }
    }
  }
}
