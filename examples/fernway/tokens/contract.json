{
  "card": {
    "shadow": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.3, 0.03, 70], "alpha": 0.12 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": -8, "unit": "px" }
      }
    }
  },
  "text": {
    "label": {
      "font": {
        "family": { "$type": "fontFamily", "$value": { "$ref": "#/font/family/mono/$value" } },
        "letter-spacing": { "$type": "dimension", "$value": { "value": 0.06, "unit": "rem" } },
        "text-transform": { "$type": "textTransform", "$value": "uppercase" }
      }
    }
  },
  "motion": {
    "$description": "Each motion role a little slower than Todae's.",
    "reveal": {
      "duration": {
        "$type": "duration",
        "enter": { "$value": { "value": 240, "unit": "ms" } },
        "exit": { "$value": { "value": 200, "unit": "ms" } }
      }
    },
    "popup": {
      "duration": {
        "$type": "duration",
        "enter": { "$value": { "value": 280, "unit": "ms" } },
        "exit": { "$value": { "value": 200, "unit": "ms" } }
      }
    },
    "window": {
      "duration": {
        "$type": "duration",
        "enter": { "$value": { "value": 340, "unit": "ms" } },
        "exit": { "$value": { "value": 240, "unit": "ms" } }
      }
    },
    "panel": {
      "duration": {
        "$type": "duration",
        "enter": { "$value": { "value": 340, "unit": "ms" } },
        "exit": { "$value": { "value": 280, "unit": "ms" } }
      }
    },
    "notice": {
      "duration": {
        "$type": "duration",
        "enter": { "$value": { "value": 280, "unit": "ms" } },
        "exit": { "$value": { "value": 200, "unit": "ms" } }
      }
    }
  },
  "popover": {
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "enter": { "$value": [0.33, 1, 0.68, 1] },
        "exit": { "$value": [0.32, 0, 0.67, 0] }
      },
      "scale": { "$type": "number", "$description": "Popovers grow a little more than Todae's.", "$value": 0.95 }
    }
  },
  "dialog": {
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "enter": {
          "$description": "A dialog's rise overshoots slightly at the end, so it lands softly, like a cabin door swinging to.",
          "$value": [0.34, 1.3, 0.64, 1]
        },
        "exit": { "$value": [0.32, 0, 0.67, 0] }
      },
      "offset": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } }
    }
  },
  "toast": {
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "enter": { "$value": [0.33, 1, 0.68, 1] },
        "exit": { "$value": [0.32, 0, 0.67, 0] }
      },
      "offset": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } }
    }
  },
  "sheet": {
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "enter": { "$value": [0.33, 1, 0.68, 1] },
        "exit": { "$value": [0.32, 0, 0.67, 0] }
      }
    }
  },
  "drawer": {
    "motion": {
      "easing": {
        "$type": "cubicBezier",
        "enter": { "$value": [0.33, 1, 0.68, 1] },
        "exit": { "$value": [0.32, 0, 0.67, 0] }
      }
    }
  }
}
