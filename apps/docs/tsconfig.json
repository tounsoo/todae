{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@tounsoo/todae": ["../../packages/design-system/src/index.ts"],
      "@tounsoo/todae/stack": ["../../packages/design-system/src/server/stack.ts"],
      "@tounsoo/todae/text": ["../../packages/design-system/src/server/text.ts"],
      "@tounsoo/todae/label": ["../../packages/design-system/src/server/label.ts"],
      "@tounsoo/todae/badge": ["../../packages/design-system/src/server/badge.ts"],
      "@tounsoo/todae/card": ["../../packages/design-system/src/server/card.ts"],
      "@tounsoo/todae/breadcrumbs": ["../../packages/design-system/src/server/breadcrumbs.ts"],
      "@tounsoo/todae/grid": ["../../packages/design-system/src/server/grid.ts"],
      "@tounsoo/todae/pagination": ["../../packages/design-system/src/server/pagination.ts"],
      "@tounsoo/todae/link": ["../../packages/design-system/src/server/link.ts"],
      "@tounsoo/todae/disclosure": ["../../packages/design-system/src/server/disclosure.ts"],
      "@tounsoo/todae/separator": ["../../packages/design-system/src/server/separator.ts"],
      "@tounsoo/todae/table": ["../../packages/design-system/src/server/table.ts"],
      "@tounsoo/todae/progress": ["../../packages/design-system/src/server/progress.ts"],
      "@tounsoo/todae/meter": ["../../packages/design-system/src/server/meter.ts"],
      "@tounsoo/todae/spinner": ["../../packages/design-system/src/server/spinner.ts"],
      "@tounsoo/todae/skeleton": ["../../packages/design-system/src/server/skeleton.ts"],
      "@tounsoo/todae/slider": ["../../packages/design-system/src/server/slider.ts"],
      "@tounsoo/todae/code": ["../../packages/design-system/src/server/code.ts"],
      "@tounsoo/todae/kbd": ["../../packages/design-system/src/server/kbd.ts"],
      "@tounsoo/todae/visually-hidden": ["../../packages/design-system/src/server/visually-hidden.ts"],
      "@tounsoo/todae/todae.css": ["../../packages/design-system/src/styles/todae.css"],
      "@tounsoo/todae/schema/components.json": ["../../packages/design-system/schema/components.json"],
      "@tounsoo/todae/tokens.json": ["../../packages/design-system/tokens/tokens.generated.json"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
