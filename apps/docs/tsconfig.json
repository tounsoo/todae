{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022",
      "ES2023.Intl",
      "ESNext.Temporal"
    ],
    "types": ["mdx", "node"],
    "noUncheckedSideEffectImports": false,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "paths": {
      "@omsoo.design/todae": ["../../packages/design-system/src/index.ts"],
      "@omsoo.design/todae/stack": ["../../packages/design-system/src/server/stack.ts"],
      "@omsoo.design/todae/text": ["../../packages/design-system/src/server/text.ts"],
      "@omsoo.design/todae/label": ["../../packages/design-system/src/server/label.ts"],
      "@omsoo.design/todae/badge": ["../../packages/design-system/src/server/badge.ts"],
      "@omsoo.design/todae/card": ["../../packages/design-system/src/server/card.ts"],
      "@omsoo.design/todae/breadcrumbs": ["../../packages/design-system/src/server/breadcrumbs.ts"],
      "@omsoo.design/todae/grid": ["../../packages/design-system/src/server/grid.ts"],
      "@omsoo.design/todae/pagination": ["../../packages/design-system/src/server/pagination.ts"],
      "@omsoo.design/todae/link": ["../../packages/design-system/src/server/link.ts"],
      "@omsoo.design/todae/disclosure": ["../../packages/design-system/src/server/disclosure.ts"],
      "@omsoo.design/todae/separator": ["../../packages/design-system/src/server/separator.ts"],
      "@omsoo.design/todae/prose": ["../../packages/design-system/src/server/prose.ts"],
      "@omsoo.design/todae/table": ["../../packages/design-system/src/server/table.ts"],
      "@omsoo.design/todae/progress": ["../../packages/design-system/src/server/progress.ts"],
      "@omsoo.design/todae/meter": ["../../packages/design-system/src/server/meter.ts"],
      "@omsoo.design/todae/spinner": ["../../packages/design-system/src/server/spinner.ts"],
      "@omsoo.design/todae/skeleton": ["../../packages/design-system/src/server/skeleton.ts"],
      "@omsoo.design/todae/slider": ["../../packages/design-system/src/server/slider.ts"],
      "@omsoo.design/todae/code": ["../../packages/design-system/src/server/code.ts"],
      "@omsoo.design/todae/kbd": ["../../packages/design-system/src/server/kbd.ts"],
      "@omsoo.design/todae/visually-hidden": ["../../packages/design-system/src/server/visually-hidden.ts"],
      "@omsoo.design/todae/todae.css": ["../../packages/design-system/src/styles/todae.css"],
      "@omsoo.design/todae/schema/components.json": ["../../packages/design-system/schema/components.json"],
      "@omsoo.design/todae/tokens.json": ["../../packages/design-system/tokens/tokens.generated.json"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
