{
  "version": 1,
  "components": [
    {
      "name": "BottomSheet",
      "description": "Modal bottom sheet. Custom portal, not a native dialog. Mid and full snap.",
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "required": true,
          "description": "Controlled open state."
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean, reason: SheetCloseReason) => void",
          "required": true,
          "description": "Dismiss requests. Staying open keeps the sheet open."
        },
        {
          "name": "snap",
          "type": "\"mid\" | \"full\"",
          "required": false,
          "description": "Controlled snap. Omit for uncontrolled."
        },
        {
          "name": "defaultSnap",
          "type": "\"mid\" | \"full\"",
          "required": false,
          "description": "Initial snap when uncontrolled.",
          "default": "\"mid\""
        },
        {
          "name": "snapPoints",
          "type": "ReadonlyArray<\"mid\" | \"full\">",
          "required": false,
          "description": "Allowed snaps. [\"full\"] disables mid.",
          "default": "[\"mid\", \"full\"]"
        },
        {
          "name": "dismissOnEscape",
          "type": "boolean",
          "required": false,
          "description": "Escape calls onOpenChange(false, \"escape\").",
          "default": "true"
        },
        {
          "name": "dismissOnScrim",
          "type": "boolean",
          "required": false,
          "description": "Scrim click calls onOpenChange(false, \"scrim\").",
          "default": "true"
        },
        {
          "name": "dismissOnDrag",
          "type": "boolean",
          "required": false,
          "description": "Drag past the threshold dismisses.",
          "default": "true"
        },
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Name when BottomSheet.Title is omitted."
        }
      ]
    },
    {
      "name": "BottomSheet.Body",
      "description": "Scroll container. Drag starts only at scrollTop 0.",
      "props": []
    },
    {
      "name": "BottomSheet.Close",
      "description": "Ghost Button that requests close-button dismiss.",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Accessible name.",
          "default": "\"Close\""
        }
      ]
    },
    {
      "name": "BottomSheet.Description",
      "description": "Supporting text. Wires aria-describedby.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Description text."
        }
      ]
    },
    {
      "name": "BottomSheet.Footer",
      "description": "Action row.",
      "props": []
    },
    {
      "name": "BottomSheet.Grabber",
      "description": "Drag handle. Rendered by default if omitted. Arrow keys change snap.",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Name of the resize control.",
          "default": "\"Resize sheet\""
        }
      ]
    },
    {
      "name": "BottomSheet.Header",
      "description": "Chrome. Drag-eligible.",
      "props": []
    },
    {
      "name": "BottomSheet.Title",
      "description": "Heading. Wires aria-labelledby.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Title text."
        }
      ]
    },
    {
      "name": "Button",
      "description": "Native button styled through the button contract tokens.",
      "props": [
        {
          "name": "variant",
          "type": "\"primary\" | \"secondary\" | \"ghost\"",
          "required": false,
          "description": "Visual style. Non-primary sets data-button-variant.",
          "default": "\"primary\""
        },
        {
          "name": "type",
          "type": "\"button\" | \"submit\" | \"reset\"",
          "required": false,
          "description": "Native button type.",
          "default": "\"button\""
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "description": "Disables the control.",
          "default": "false"
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Button label."
        }
      ]
    },
    {
      "name": "Chip",
      "description": "Text-only label with optional named dismiss. Overflow +N is Chip.Overflow.",
      "props": [
        {
          "name": "children",
          "type": "string",
          "required": true,
          "description": "Chip label. Text only."
        },
        {
          "name": "onDismiss",
          "type": "() => void",
          "required": false,
          "description": "Renders a named dismiss button."
        },
        {
          "name": "dismissLabel",
          "type": "string",
          "required": false,
          "description": "Dismiss aria-label. Default is Remove {label}."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "description": "Disables dismiss.",
          "default": "false"
        }
      ]
    },
    {
      "name": "ChipField",
      "description": "Controlled chips plus input. Commit does not mutate chips. maxRows uses model B.",
      "props": [
        {
          "name": "chips",
          "type": "string[]",
          "required": true,
          "description": "Controlled chip labels."
        },
        {
          "name": "inputValue",
          "type": "string",
          "required": true,
          "description": "Controlled input text."
        },
        {
          "name": "onInputValueChange",
          "type": "(value: string) => void",
          "required": true,
          "description": "Input text changes."
        },
        {
          "name": "onCommit",
          "type": "(value: string) => void",
          "required": true,
          "description": "Fires on a commit key with a trimmed non-empty value. Does not append chips."
        },
        {
          "name": "onChipRemove",
          "type": "(index: number, value: string) => void",
          "required": true,
          "description": "Dismiss click or Backspace on an empty input."
        },
        {
          "name": "commitKeys",
          "type": "ReadonlyArray<\"Enter\" | \"Tab\" | \",\" | \";\" | \" \">",
          "required": false,
          "description": "Closed allowlist of commit keys.",
          "default": "[\"Enter\"]"
        },
        {
          "name": "maxRows",
          "type": "number",
          "required": false,
          "description": "Caps visual rows of chips plus input. Earlier chips fold into +N."
        },
        {
          "name": "removeOnBackspace",
          "type": "boolean",
          "required": false,
          "description": "Backspace on an empty input removes the last chip.",
          "default": "true"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "description": "Disables input and dismiss.",
          "default": "false"
        },
        {
          "name": "invalid",
          "type": "boolean",
          "required": false,
          "description": "Marks the shell invalid.",
          "default": "false"
        }
      ]
    },
    {
      "name": "ChipField.Input",
      "description": "Optional input slot. Rendered automatically when omitted.",
      "props": [
        {
          "name": "placeholder",
          "type": "string",
          "required": false,
          "description": "Native placeholder."
        }
      ]
    },
    {
      "name": "DensityProvider",
      "description": "Sets data-density for spacing-only compact, comfortable, or spacious.",
      "props": [
        {
          "name": "density",
          "type": "\"compact\" | \"comfortable\" | \"spacious\"",
          "required": false,
          "description": "Spacing density written to data-density.",
          "default": "\"comfortable\""
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Subtree that inherits density tokens."
        }
      ]
    },
    {
      "name": "Dialog",
      "description": "Controlled native modal dialog. Stays centered. No sheet morph.",
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "required": true,
          "description": "Controlled open state."
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean, reason: DialogCloseReason) => void",
          "required": true,
          "description": "Dismiss requests. Staying open keeps the dialog open."
        },
        {
          "name": "dismissOnEscape",
          "type": "boolean",
          "required": false,
          "description": "Escape calls onOpenChange(false, \"escape\").",
          "default": "true"
        },
        {
          "name": "dismissOnBackdrop",
          "type": "boolean",
          "required": false,
          "description": "Scrim click calls onOpenChange(false, \"backdrop\").",
          "default": "true"
        },
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Name when Dialog.Title is omitted."
        }
      ]
    },
    {
      "name": "Dialog.Body",
      "description": "Scrollable body.",
      "props": []
    },
    {
      "name": "Dialog.Close",
      "description": "Ghost Button that requests close-button dismiss.",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Accessible name.",
          "default": "\"Close\""
        }
      ]
    },
    {
      "name": "Dialog.Description",
      "description": "Supporting text. Wires aria-describedby on the dialog.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Description text."
        }
      ]
    },
    {
      "name": "Dialog.Footer",
      "description": "Action row.",
      "props": []
    },
    {
      "name": "Dialog.Header",
      "description": "Optional header row.",
      "props": []
    },
    {
      "name": "Dialog.Title",
      "description": "Heading. Wires aria-labelledby on the dialog.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Title text."
        }
      ]
    },
    {
      "name": "Option",
      "description": "String-only option. Also available as OptionList.Option.",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "Selection value."
        },
        {
          "name": "children",
          "type": "string",
          "required": true,
          "description": "Visible label. Text only."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "description": "Skips pointer and keyboard selection.",
          "default": "false"
        }
      ]
    },
    {
      "name": "OptionList",
      "description": "Listbox. Single or multiple. Option children are strings. Does not close a Popover.",
      "props": [
        {
          "name": "selectionMode",
          "type": "\"single\" | \"multiple\"",
          "required": false,
          "description": "Single fires onChange(string). Multiple fires onChange(string[]).",
          "default": "\"single\""
        },
        {
          "name": "value",
          "type": "string | null | readonly string[]",
          "required": true,
          "description": "Selected value, or values when selectionMode is multiple."
        },
        {
          "name": "onChange",
          "type": "(value: string | string[]) => void",
          "required": true,
          "description": "Selection change. Single passes a string. Multiple passes the next array."
        },
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Name when no visible label is present."
        }
      ]
    },
    {
      "name": "OptionList.Option",
      "description": "String-only option. Same as the top-level Option export.",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "Selection value."
        },
        {
          "name": "children",
          "type": "string",
          "required": true,
          "description": "Visible label. Text only."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "description": "Skips pointer and keyboard selection.",
          "default": "false"
        }
      ]
    },
    {
      "name": "Popover",
      "description": "Non-modal popover=\"manual\". Controlled open. hidePopover only when open is false.",
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "required": true,
          "description": "Controlled open state."
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean, reason: PopoverCloseReason) => void",
          "required": true,
          "description": "Dismiss or trigger requests. Staying open keeps the popover open."
        },
        {
          "name": "anchorRef",
          "type": "RefObject<HTMLElement | null>",
          "required": false,
          "description": "Positioning target when Popover.Trigger is omitted."
        }
      ]
    },
    {
      "name": "Popover.Content",
      "description": "Manual popover surface. Syncs showPopover and hidePopover to the open prop.",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": false,
          "description": "Accessible name for the surface."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Popover contents."
        }
      ]
    },
    {
      "name": "Popover.Trigger",
      "description": "Button that toggles the popover and owns the CSS anchor.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Button label."
        }
      ]
    },
    {
      "name": "Stack",
      "description": "Flex layout. Gap comes from the stack.gap contract token.",
      "props": [
        {
          "name": "direction",
          "type": "\"row\" | \"column\"",
          "required": false,
          "description": "Flex direction.",
          "default": "\"column\""
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Laid-out children."
        }
      ]
    },
    {
      "name": "Text",
      "description": "Text styled through the text contract tokens.",
      "props": [
        {
          "name": "as",
          "type": "\"p\" | \"span\" | \"strong\"",
          "required": false,
          "description": "Rendered element.",
          "default": "\"p\""
        },
        {
          "name": "size",
          "type": "\"s\" | \"m\" | \"l\"",
          "required": false,
          "description": "Maps to text.size.2, text.size.3, text.size.4.",
          "default": "\"m\""
        },
        {
          "name": "tone",
          "type": "\"default\" | \"muted\" | \"accent\"",
          "required": false,
          "description": "Foreground role.",
          "default": "\"default\""
        },
        {
          "name": "weight",
          "type": "\"regular\" | \"medium\" | \"bold\"",
          "required": false,
          "description": "Font weight.",
          "default": "\"regular\""
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Text content."
        }
      ]
    },
    {
      "name": "TextField",
      "description": "Compound text field. One focus ring on the shared shell.",
      "props": [
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "description": "Disables the input and marks the shell.",
          "default": "false"
        },
        {
          "name": "invalid",
          "type": "boolean",
          "required": false,
          "description": "Marks the shell invalid and sets aria-invalid on the input.",
          "default": "false"
        },
        {
          "name": "id",
          "type": "string",
          "required": false,
          "description": "Input id. Auto-generated when omitted."
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Native input name."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Input and optional IconStart, IconEnd, Prefix, Suffix."
        }
      ]
    },
    {
      "name": "TextField.IconEnd",
      "description": "Trailing icon slot. Decorative unless interactive.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Icon or control."
        },
        {
          "name": "interactive",
          "type": "boolean",
          "required": false,
          "description": "When false, the wrapper is aria-hidden.",
          "default": "false"
        }
      ]
    },
    {
      "name": "TextField.IconStart",
      "description": "Leading icon slot. Decorative unless interactive.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Icon or control."
        },
        {
          "name": "interactive",
          "type": "boolean",
          "required": false,
          "description": "When false, the wrapper is aria-hidden.",
          "default": "false"
        }
      ]
    },
    {
      "name": "TextField.Input",
      "description": "Controlled text-ish input inside TextField.",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "Controlled value."
        },
        {
          "name": "onChange",
          "type": "(event: ChangeEvent<HTMLInputElement>) => void",
          "required": true,
          "description": "Native change handler."
        },
        {
          "name": "onValueChange",
          "type": "(value: string) => void",
          "required": false,
          "description": "Optional value callback."
        },
        {
          "name": "placeholder",
          "type": "string",
          "required": false,
          "description": "Native placeholder."
        },
        {
          "name": "type",
          "type": "\"text\" | \"search\" | \"email\" | \"url\" | \"tel\" | \"password\"",
          "required": false,
          "description": "Text-ish input types only.",
          "default": "\"text\""
        }
      ]
    },
    {
      "name": "TextField.Prefix",
      "description": "Leading text or node before the input.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Prefix content. Strings render as text."
        }
      ]
    },
    {
      "name": "TextField.Suffix",
      "description": "Trailing text or node after the input.",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Suffix content. Strings render as text."
        }
      ]
    },
    {
      "name": "ThemeProvider",
      "description": "Sets data-appearance from system, light, or dark. Nested providers override.",
      "props": [
        {
          "name": "appearance",
          "type": "\"system\" | \"light\" | \"dark\"",
          "required": false,
          "description": "Resolved to light or dark before writing data-appearance. Never writes system.",
          "default": "\"system\""
        },
        {
          "name": "overrides",
          "type": "ThemeOverride",
          "required": false,
          "description": "Closed allowlist of raw, semantic, and component token paths. Values are typed; unknown keys and raw CSS are rejected."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false,
          "description": "Themed subtree."
        }
      ]
    },
    {
      "name": "useChipField",
      "description": "Optional state helper. ChipField stays fully controlled without it.",
      "props": [
        {
          "name": "initialChips",
          "type": "string[]",
          "required": false,
          "description": "Starting chips.",
          "default": "[]"
        },
        {
          "name": "initialInputValue",
          "type": "string",
          "required": false,
          "description": "Starting input text.",
          "default": "\"\""
        },
        {
          "name": "dedupe",
          "type": "boolean",
          "required": false,
          "description": "Skip commits that already exist.",
          "default": "true"
        },
        {
          "name": "transform",
          "type": "(raw: string) => string | null",
          "required": false,
          "description": "Normalize a commit. Null rejects. Default trims and rejects empty."
        }
      ]
    }
  ]
}
