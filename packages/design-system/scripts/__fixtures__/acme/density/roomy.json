{
  "space": {
    "control": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/5/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/3/$value" } }
    },
    "stack": {
      "gap": { "$type": "dimension", "$value": { "$ref": "#/space/7/$value" } },
      "gap-condensed": { "$type": "dimension", "$value": { "$ref": "#/space/3/$value" } },
      "gap-spacious": { "$type": "dimension", "$value": { "$ref": "#/space/10/$value" } }
    },
    "inline": {
      "gap": { "$type": "dimension", "$value": { "$ref": "#/space/3/$value" } }
    },
    "chip": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/3/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/1/$value" } }
    },
    "field": {
      "gap": { "$type": "dimension", "$value": { "$ref": "#/space/2/$value" } }
    },
    "selection": {
      "size": { "$type": "dimension", "$value": { "$ref": "#/space/8/$value" } },
      "gap": { "$type": "dimension", "$value": { "$ref": "#/space/3/$value" } }
    },
    "overlay": {
      "padding": { "$type": "dimension", "$value": { "$ref": "#/space/8/$value" } },
      "gap": { "$type": "dimension", "$value": { "$ref": "#/space/5/$value" } }
    }
  }
}
