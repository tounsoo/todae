{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/test", "src/**/*.meta.ts", "src/meta.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
