{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.meta.ts", "src/**/*.pattern.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
