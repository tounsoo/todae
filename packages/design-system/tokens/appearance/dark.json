{
  "color": {
    "bg": {
      "canvas": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "surface": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "subtle": { "$type": "color", "$value": { "$ref": "#/color/gray/800/$value" } },
      "elevated": { "$type": "color", "$value": { "$ref": "#/color/gray/800/$value" } },
      "scrim": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [{ "$ref": "#/color/gray/950/$value/components/0" }, { "$ref": "#/color/gray/950/$value/components/1" }, { "$ref": "#/color/gray/950/$value/components/2" }], "alpha": 0.7 } },
      "transparent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [{ "$ref": "#/color/gray/900/$value/components/0" }, { "$ref": "#/color/gray/900/$value/components/1" }, { "$ref": "#/color/gray/900/$value/components/2" }], "alpha": 0 } },
      "highlight": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [{ "$ref": "#/color/fg/default/$value/components/0" }, { "$ref": "#/color/fg/default/$value/components/1" }, { "$ref": "#/color/fg/default/$value/components/2" }], "alpha": 0.1 } },
      "selected": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [{ "$ref": "#/color/accent/default/$value/components/0" }, { "$ref": "#/color/accent/default/$value/components/1" }, { "$ref": "#/color/accent/default/$value/components/2" }], "alpha": 0.2 } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "muted": { "$type": "color", "$value": { "$ref": "#/color/gray/200/$value" } },
      "placeholder": { "$type": "color", "$value": { "$ref": "#/color/gray/300/$value" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "subtle": { "$type": "color", "$value": { "$ref": "#/color/gray/700/$value" } }
    },
    "danger": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/red/300/$value" } }
    },
    "accent": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/gray/100/$value" } },
      "active": { "$type": "color", "$value": { "$ref": "#/color/gray/200/$value" } },
      "soft": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [{ "$ref": "#/color/accent/default/$value/components/0" }, { "$ref": "#/color/accent/default/$value/components/1" }, { "$ref": "#/color/accent/default/$value/components/2" }], "alpha": 0.12 } },
      "soft-strong": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [{ "$ref": "#/color/accent/default/$value/components/0" }, { "$ref": "#/color/accent/default/$value/components/1" }, { "$ref": "#/color/accent/default/$value/components/2" }], "alpha": 0.28 } }
    },
    "status": {
      "info": {
        "fg": { "$type": "color", "$value": { "$ref": "#/color/gray/100/$value" } },
        "bg": { "$type": "color", "$value": { "$ref": "#/color/gray/800/$value" } },
        "border": { "$type": "color", "$value": { "$ref": "#/color/gray/600/$value" } }
      },
      "success": {
        "fg": { "$type": "color", "$value": { "$ref": "#/color/green/200/$value" } },
        "bg": { "$type": "color", "$value": { "$ref": "#/color/green/900/$value" } },
        "border": { "$type": "color", "$value": { "$ref": "#/color/green/700/$value" } }
      },
      "warning": {
        "fg": { "$type": "color", "$value": { "$ref": "#/color/amber/200/$value" } },
        "bg": { "$type": "color", "$value": { "$ref": "#/color/amber/900/$value" } },
        "border": { "$type": "color", "$value": { "$ref": "#/color/amber/700/$value" } }
      },
      "critical": {
        "fg": { "$type": "color", "$value": { "$ref": "#/color/red/200/$value" } },
        "bg": { "$type": "color", "$value": { "$ref": "#/color/red/900/$value" } },
        "border": { "$type": "color", "$value": { "$ref": "#/color/red/700/$value" } }
      }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "#/color/gray/950/$value" } }
  }
}
