{
  "color": {
    "bg": {
      "canvas": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "surface": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "subtle": { "$type": "color", "$value": { "$ref": "#/color/gray/800/$value" } },
      "elevated": { "$type": "color", "$value": { "$ref": "#/color/gray/800/$value" } },
      "scrim": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.16, 0.02, 260], "alpha": 0.7 } },
      "transparent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.22, 0.02, 260], "alpha": 0 } },
      "highlight": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.98, 0.005, 260], "alpha": 0.1 } },
      "selected": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 255], "alpha": 0.12 } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "muted": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "placeholder": { "$type": "color", "$value": { "$ref": "#/color/gray/400/$value" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "subtle": { "$type": "color", "$value": { "$ref": "#/color/gray/700/$value" } }
    },
    "danger": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/red/400/$value" } }
    },
    "accent": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/blue/500/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/blue/400/$value" } },
      "active": { "$type": "color", "$value": { "$ref": "#/color/blue/600/$value" } },
      "soft": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 255], "alpha": 0.12 } },
      "soft-strong": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 255], "alpha": 0.2 } }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } }
  }
}
