{
  "color": {
    "bg": {
      "canvas": { "$type": "color", "$value": { "$ref": "color.gray.900" } },
      "surface": { "$type": "color", "$value": { "$ref": "color.gray.900" } },
      "subtle": { "$type": "color", "$value": { "$ref": "color.gray.800" } },
      "elevated": { "$type": "color", "$value": { "$ref": "color.gray.800" } },
      "scrim": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.16, 0.02, 260], "alpha": 0.7 } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "color.gray.50" } },
      "muted": { "$type": "color", "$value": { "$ref": "color.gray.50" } },
      "placeholder": { "$type": "color", "$value": { "$ref": "color.gray.400" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "color.gray.50" } },
      "subtle": { "$type": "color", "$value": { "$ref": "color.gray.700" } }
    },
    "danger": {
      "default": { "$type": "color", "$value": { "$ref": "color.red.400" } }
    },
    "accent": {
      "default": { "$type": "color", "$value": { "$ref": "color.blue.500" } },
      "hover": { "$type": "color", "$value": { "$ref": "color.blue.400" } },
      "active": { "$type": "color", "$value": { "$ref": "color.blue.600" } }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "color.gray.50" } }
  }
}
