{
  "color": {
    "bg": {
      "canvas": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "surface": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "subtle": { "$type": "color", "$value": { "$ref": "#/color/gray/100/$value" } },
      "elevated": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } },
      "scrim": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.16, 0.02, 260], "alpha": 0.45 } },
      "transparent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.98, 0.005, 260], "alpha": 0 } },
      "highlight": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.22, 0.02, 260], "alpha": 0.08 } },
      "selected": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 255], "alpha": 0.12 } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "muted": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "placeholder": { "$type": "color", "$value": { "$ref": "#/color/gray/600/$value" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/gray/900/$value" } },
      "subtle": { "$type": "color", "$value": { "$ref": "#/color/gray/300/$value" } }
    },
    "danger": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/red/600/$value" } }
    },
    "accent": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/blue/500/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/blue/400/$value" } },
      "active": { "$type": "color", "$value": { "$ref": "#/color/blue/600/$value" } },
      "soft": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 255], "alpha": 0.12 } },
      "soft-strong": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.18, 255], "alpha": 0.2 } }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "#/color/gray/50/$value" } }
  }
}
