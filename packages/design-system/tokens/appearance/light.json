{
  "color": {
    "bg": {
      "canvas": { "$type": "color", "$value": { "$ref": "color.gray.50" } },
      "surface": { "$type": "color", "$value": { "$ref": "color.gray.50" } },
      "subtle": { "$type": "color", "$value": { "$ref": "color.gray.100" } },
      "elevated": { "$type": "color", "$value": { "$ref": "color.gray.50" } },
      "scrim": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.16, 0.02, 260], "alpha": 0.45 } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "color.gray.900" } },
      "muted": { "$type": "color", "$value": { "$ref": "color.gray.900" } },
      "placeholder": { "$type": "color", "$value": { "$ref": "color.gray.600" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "color.gray.900" } },
      "subtle": { "$type": "color", "$value": { "$ref": "color.gray.300" } }
    },
    "danger": {
      "default": { "$type": "color", "$value": { "$ref": "color.red.600" } }
    },
    "accent": {
      "default": { "$type": "color", "$value": { "$ref": "color.blue.500" } },
      "hover": { "$type": "color", "$value": { "$ref": "color.blue.400" } },
      "active": { "$type": "color", "$value": { "$ref": "color.blue.600" } }
    },
    "on-accent": { "$type": "color", "$value": { "$ref": "color.gray.50" } }
  }
}
