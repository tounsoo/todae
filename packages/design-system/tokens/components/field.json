{
  "field": {
    "radius": { "$type": "dimension", "$value": { "$ref": "radius.md" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "space.control.x" } },
      "y": { "$type": "dimension", "$value": { "$ref": "space.control.y" } }
    },
    "gap": { "$type": "dimension", "$value": { "$ref": "space.field.gap" } },
    "font": {
      "size": { "$type": "dimension", "$value": { "$ref": "font.size.3" } }
    },
    "leading": { "$type": "number", "$value": { "$ref": "font.leading.default" } },
    "min-width": { "$type": "dimension", "$value": { "$ref": "space.12" } },
    "bg": {
      "default": { "$type": "color", "$value": { "$ref": "color.bg.surface" } },
      "disabled": { "$type": "color", "$value": { "$ref": "color.bg.subtle" } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "color.fg.default" } },
      "disabled": { "$type": "color", "$value": { "$ref": "color.fg.placeholder" } },
      "placeholder": { "$type": "color", "$value": { "$ref": "color.fg.placeholder" } },
      "adornment": { "$type": "color", "$value": { "$ref": "color.fg.placeholder" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "color.border.default" } },
      "hover": { "$type": "color", "$value": { "$ref": "color.border.default" } },
      "focus": { "$type": "color", "$value": { "$ref": "color.accent.default" } },
      "disabled": { "$type": "color", "$value": { "$ref": "color.border.subtle" } },
      "invalid": { "$type": "color", "$value": { "$ref": "color.danger.default" } }
    },
    "ring": {
      "focus": { "$type": "color", "$value": { "$ref": "color.accent.default" } },
      "invalid": { "$type": "color", "$value": { "$ref": "color.danger.default" } }
    },
    "label": {
      "gap": { "$type": "dimension", "$value": { "value": 0.4, "unit": "rem" } },
      "font": {
        "size": { "$type": "dimension", "$value": { "$ref": "font.size.2" } },
        "weight": { "$type": "fontWeight", "$value": { "$ref": "font.weight.medium" } }
      },
      "fg": { "$type": "color", "$value": { "$ref": "color.fg.default" } }
    },
    "description": {
      "font": {
        "size": { "$type": "dimension", "$value": { "$ref": "font.size.2" } },
        "weight": { "$type": "fontWeight", "$value": { "$ref": "font.weight.regular" } }
      },
      "fg": { "$type": "color", "$value": { "$ref": "color.fg.muted" } }
    },
    "error": {
      "font": {
        "size": { "$type": "dimension", "$value": { "$ref": "font.size.2" } },
        "weight": { "$type": "fontWeight", "$value": { "$ref": "font.weight.regular" } }
      },
      "fg": { "$type": "color", "$value": { "$ref": "color.danger.default" } }
    },
    "messages": {
      "gap": { "$type": "dimension", "$value": { "value": 0.2, "unit": "rem" } }
    },
    "counter": {
      "emphasis": {
        "weight": { "$type": "fontWeight", "$value": 600 }
      }
    }
  }
}
