{
  "popover": {
    "$description": "Popover.Root: a floating panel anchored to a trigger; Menu and the field pickers draw on it. It opens by growing from its trigger (motion.scale) and closes by shrinking back.",
    "bg": { "$type": "color", "$value": { "$ref": "#/color/bg/elevated/$value" } },
    "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
    "border": { "$type": "color", "$value": { "$ref": "#/color/border/default/$value" } },
    "shadow": { "$type": "shadow", "$value": { "$ref": "#/shadow/none/$value" } },
    "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/md/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/popover/padding/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/popover/padding/$value" } }
    },
    "offset": { "$type": "dimension", "$value": { "$ref": "#/space/1/$value" } },
    "max-height": { "$type": "dimension", "$value": { "value": 20, "unit": "rem" } },
    "motion": {
      "duration": {
        "enter": { "$type": "duration", "$value": { "$ref": "#/motion/duration/moderate/$value" } },
        "exit": { "$type": "duration", "$value": { "$ref": "#/motion/duration/normal/$value" } }
      },
      "easing": {
        "enter": { "$type": "cubicBezier", "$value": { "$ref": "#/overlay/motion/easing/enter/$value" } },
        "exit": { "$type": "cubicBezier", "$value": { "$ref": "#/overlay/motion/easing/exit/$value" } }
      },
      "scale": { "$type": "number", "$value": 0.96 }
    }
  }
}
