{
  "disclosure": {
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/inline/gap/$value" } },
    "padding": {
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/control/y/$value" } }
    },
    "border": { "$type": "color", "$value": { "$ref": "#/color/border/subtle/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "summary": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "font": {
        "weight": { "$type": "fontWeight", "$value": { "$ref": "#/font/weight/medium/$value" } }
      }
    },
    "marker": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/muted/$value" } },
      "scale": { "$type": "number", "$value": 1 }
    },
    "ring": {
      "focus": { "$type": "color", "$value": { "$ref": "#/focus/ring/color/$value" } },
      "radius": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
    },
    "motion": {
      "duration": { "$type": "duration", "$value": { "$ref": "#/motion/duration/normal/$value" } },
      "easing": { "$type": "cubicBezier", "$value": { "$ref": "#/motion/easing/standard/$value" } }
    }
  }
}
