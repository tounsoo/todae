{
  "sheet": {
    "$description": "BottomSheet.Root: a modal panel that rises from the bottom edge, with a drag handle and snap points.",
    "bg": { "$type": "color", "$value": { "$ref": "#/color/bg/elevated/$value" } },
    "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
    "border": { "$type": "color", "$value": { "$ref": "#/color/border/default/$value" } },
    "ring": {
      "focus": { "$type": "color", "$value": { "$ref": "#/focus/ring/color/$value" } }
    },
    "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/lg/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/overlay/padding/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/overlay/padding/$value" } }
    },
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/overlay/gap/$value" } },
    "title": {
      "font": {
        "size": { "$type": "dimension", "$value": { "$ref": "#/dialog/title/font/size/$value" } },
        "weight": { "$type": "fontWeight", "$value": { "$ref": "#/dialog/title/font/weight/$value" } }
      }
    },
    "grabber": {
      "bg": { "$type": "color", "$value": { "$ref": "#/color/border/subtle/$value" } },
      "width": { "$type": "dimension", "$value": { "$ref": "#/space/9/$value" } },
      "height": { "$type": "dimension", "$value": { "$ref": "#/space/1/$value" } },
      "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/full/$value" } }
    },
    "handle": {
      "hit": { "$type": "dimension", "$value": { "$ref": "#/space/11/$value" } }
    },
    "snap": {
      "mid": { "$type": "number", "$value": 0.5 },
      "full-inset": { "$type": "dimension", "$value": { "$ref": "#/space/6/$value" } }
    },
    "motion": {
      "enter": { "$type": "duration", "$value": { "$ref": "#/motion/duration/slow/$value" } },
      "exit": { "$type": "duration", "$value": { "$ref": "#/motion/duration/moderate/$value" } },
      "resize": { "$type": "duration", "$value": { "$ref": "#/motion/duration/slower/$value" } }
    }
  }
}
