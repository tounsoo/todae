{
  "loader": {
    "$description": "Loader.Root: the spinner and dots loading indicators.",
    "size": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "thickness": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "track-tint": { "$type": "number", "$value": { "$ref": "#/opacity/20/$value" } },
    "motion": {
      "duration": { "$type": "duration", "$value": { "value": 800, "unit": "ms" } }
    }
  }
}
