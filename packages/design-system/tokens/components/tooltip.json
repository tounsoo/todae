{
  "tooltip": {
    "bg": { "$type": "color", "$value": { "$ref": "color.bg.elevated" } },
    "fg": { "$type": "color", "$value": { "$ref": "color.fg.default" } },
    "border": { "$type": "color", "$value": { "$ref": "color.border.default" } },
    "radius": { "$type": "dimension", "$value": { "$ref": "radius.sm" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "space.2" } },
      "y": { "$type": "dimension", "$value": { "$ref": "space.1" } }
    },
    "max-width": { "$type": "dimension", "$value": { "value": 16, "unit": "rem" } }
  }
}
