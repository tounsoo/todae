{
  "tooltip": {
    "$description": "Tooltip.Root: a short label shown on hover or focus, or an interactive panel.",
    "bg": { "$type": "color", "$value": { "$ref": "#/color/bg/elevated/$value" } },
    "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
    "border": { "$type": "color", "$value": { "$ref": "#/color/border/default/$value" } },
    "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/sm/$value" } },
    "offset": { "$type": "dimension", "$value": { "$ref": "#/space/1/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/2/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/1/$value" } }
    },
    "max-width": { "$type": "dimension", "$value": { "value": 16, "unit": "rem" } },
    "delay": {
      "show": { "$type": "duration", "$value": { "value": 300, "unit": "ms" } },
      "hide": { "$type": "duration", "$value": { "value": 100, "unit": "ms" } }
    }
  }
}
