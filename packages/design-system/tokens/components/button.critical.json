{
  "button": {
    "critical": {
      "$description": "The critical Button.Root variant: the irreversible action in a confirm dialog. Colors per state, from the danger and status critical scales.",
      "bg": {
        "default": { "$type": "color", "$value": { "$ref": "#/color/danger/default/$value" } },
        "hover": { "$type": "color", "$value": { "$ref": "#/color/status/critical/fg/$value" } },
        "active": { "$type": "color", "$value": { "$ref": "#/color/status/critical/fg/$value" } },
        "focus": { "$type": "color", "$value": { "$ref": "#/color/danger/default/$value" } },
        "disabled": { "$type": "color", "$value": { "$ref": "#/color/status/critical/bg/$value" } }
      },
      "fg": {
        "default": { "$type": "color", "$value": { "$ref": "#/color/on-accent/$value" } },
        "hover": { "$type": "color", "$value": { "$ref": "#/color/on-accent/$value" } },
        "active": { "$type": "color", "$value": { "$ref": "#/color/status/critical/bg/$value" } },
        "focus": { "$type": "color", "$value": { "$ref": "#/color/on-accent/$value" } },
        "disabled": { "$type": "color", "$value": { "$ref": "#/color/status/critical/fg/$value" } }
      },
      "border": {
        "default": { "$type": "color", "$value": { "$ref": "#/color/danger/default/$value" } },
        "hover": { "$type": "color", "$value": { "$ref": "#/color/status/critical/fg/$value" } },
        "active": { "$type": "color", "$value": { "$ref": "#/color/status/critical/border/$value" } },
        "focus": { "$type": "color", "$value": { "$ref": "#/color/danger/default/$value" } },
        "disabled": { "$type": "color", "$value": { "$ref": "#/color/status/critical/border/$value" } }
      },
      "ring": {
        "focus": { "$type": "color", "$value": { "$ref": "#/focus/ring/$value" } }
      },
      "shadow": { "$type": "shadow", "$value": { "$ref": "#/shadow/none/$value" } }
    }
  }
}
