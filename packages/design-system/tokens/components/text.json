{
  "text": {
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "color.fg.default" } },
      "muted": { "$type": "color", "$value": { "$ref": "color.fg.muted" } },
      "accent": { "$type": "color", "$value": { "$ref": "color.accent.default" } }
    },
    "size": {
      "1": { "$type": "dimension", "$value": { "$ref": "font.size.1" } },
      "2": { "$type": "dimension", "$value": { "$ref": "font.size.2" } },
      "3": { "$type": "dimension", "$value": { "$ref": "font.size.3" } },
      "4": { "$type": "dimension", "$value": { "$ref": "font.size.4" } },
      "5": { "$type": "dimension", "$value": { "$ref": "font.size.5" } },
      "6": { "$type": "dimension", "$value": { "$ref": "font.size.6" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": { "$ref": "font.weight.regular" } },
      "medium": { "$type": "fontWeight", "$value": { "$ref": "font.weight.medium" } },
      "bold": { "$type": "fontWeight", "$value": { "$ref": "font.weight.bold" } }
    },
    "leading": {
      "default": { "$type": "number", "$value": { "$ref": "font.leading.default" } }
    }
  }
}
