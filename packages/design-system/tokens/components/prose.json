{
  "prose": {
    "$description": "Prose.Root: long-form text such as rendered markdown, with headings and lists.",
    "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
    "leading": { "$type": "number", "$value": { "$ref": "#/font/leading/default/$value" } },
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/prose/gap/$value" } },
    "heading": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "weight": { "$type": "fontWeight", "$value": { "$ref": "#/font/weight/bold/$value" } },
      "leading": { "$type": "number", "$value": { "$ref": "#/font/leading/tight/$value" } },
      "space-before": { "$type": "dimension", "$value": { "$ref": "#/space/prose/heading-before/$value" } },
      "space-after": { "$type": "dimension", "$value": { "$ref": "#/space/prose/heading-after/$value" } }
    },
    "list": {
      "indent": { "$type": "dimension", "$value": { "$ref": "#/space/6/$value" } },
      "item-gap": { "$type": "dimension", "$value": { "$ref": "#/space/prose/item-gap/$value" } }
    },
    "quote": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/muted/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/border/default/$value" } },
      "border-width": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
      "padding": { "$type": "dimension", "$value": { "$ref": "#/space/4/$value" } }
    }
  }
}
