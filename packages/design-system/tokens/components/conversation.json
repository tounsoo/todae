{
  "conversation": {
    "$description": "Conversation.Root: the scrolling message list and its jump-to-latest button.",
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/stack/gap-spacious/$value" } },
    "scroll-button": {
      "inset": { "$type": "dimension", "$value": { "$ref": "#/space/stack/gap/$value" } }
    },
    "ring": {
      "focus": { "$type": "color", "$value": { "$ref": "#/focus/ring/$value" } }
    },
    "motion": {
      "duration": {
        "enter": { "$type": "duration", "$value": { "$ref": "#/motion/reveal/duration/enter/$value" } },
        "exit": { "$type": "duration", "$value": { "$ref": "#/motion/reveal/duration/exit/$value" } },
        "glide": { "$type": "duration", "$description": "The longest Conversation.ScrollButton's glide to the end runs before it lands there. Under reduced motion it jumps.", "$value": { "value": 500, "unit": "ms" } }
      },
      "easing": {
        "enter": { "$type": "cubicBezier", "$value": { "$ref": "#/motion/easing/enter/$value" } },
        "exit": { "$type": "cubicBezier", "$value": { "$ref": "#/motion/easing/exit/$value" } }
      }
    }
  }
}
