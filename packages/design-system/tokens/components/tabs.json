{
  "tabs": {
    "$description": "Tabs.Root: a tab list and the indicator under the selected tab.",
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/inline/gap/$value" } },
    "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/sm/$value" } },
    "leading": { "$type": "number", "$value": { "$ref": "#/font/leading/tight/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/control/x/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/control/y/$value" } }
    },
    "font": {
      "size": { "$type": "dimension", "$value": { "$ref": "#/font/size/2/$value" } },
      "weight": { "$type": "fontWeight", "$value": { "$ref": "#/font/weight/medium/$value" } },
      "letter-spacing": { "$type": "dimension", "$value": { "$ref": "#/font/letter-spacing/default/$value" } },
      "text-transform": { "$type": "textTransform", "$value": { "$ref": "#/font/text-transform/default/$value" } }
    },
    "bg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/bg/transparent/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/bg/highlight/$value" } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/fg/muted/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "selected": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "disabled": { "$type": "color", "$value": { "$ref": "#/color/fg/placeholder/$value" } }
    },
    "border": { "$type": "color", "$value": { "$ref": "#/color/border/subtle/$value" } },
    "indicator": {
      "color": { "$type": "color", "$value": { "$ref": "#/color/accent/default/$value" } },
      "size": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
    },
    "ring": {
      "focus": { "$type": "color", "$value": { "$ref": "#/focus/ring/color/$value" } }
    }
  }
}
