      "border": { "$type": "color", "$value": { "$ref": "#/color/category/4/border/$value" } }
    },
    "category-5": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/category/5/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/category/5/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/category/5/border/$value" } }
    },
    "category-6": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/category/6/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/category/6/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/category/6/border/$value" } }
    },
    "category-7": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/category/7/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/category/7/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/category/7/border/$value" } }
    },
    "category-8": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/category/8/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/category/8/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/category/8/border/$value" } }
    }
  }
}
