{
  "chip": {
    "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/sm/$value" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/chip/x/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/chip/y/$value" } }
    },
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/inline/gap/$value" } },
    "font": {
      "size": { "$type": "dimension", "$value": { "$ref": "#/font/size/2/$value" } }
    },
    "bg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/bg/subtle/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/bg/subtle/$value" } },
      "focus": { "$type": "color", "$value": { "$ref": "#/color/bg/subtle/$value" } },
      "disabled": { "$type": "color", "$value": { "$ref": "#/color/bg/subtle/$value" } }
    },
    "fg": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "focus": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
      "disabled": { "$type": "color", "$value": { "$ref": "#/color/fg/placeholder/$value" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "$ref": "#/color/border/subtle/$value" } },
      "hover": { "$type": "color", "$value": { "$ref": "#/color/border/default/$value" } },
      "focus": { "$type": "color", "$value": { "$ref": "#/color/accent/default/$value" } },
      "disabled": { "$type": "color", "$value": { "$ref": "#/color/border/subtle/$value" } }
    },
    "ring": {
      "focus": { "$type": "color", "$value": { "$ref": "#/color/accent/default/$value" } }
    },
    "leading": { "$type": "number", "$value": { "$ref": "#/font/leading/tight/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "ring-width": { "$type": "dimension", "$value": { "$ref": "#/focus/ring/width/$value" } },
    "ring-offset": { "$type": "dimension", "$value": { "$ref": "#/focus/ring/offset/$value" } },
    "dismiss": {
      "fg": {
        "default": { "$type": "color", "$value": { "$ref": "#/color/fg/placeholder/$value" } },
        "hover": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } }
      }
    },
    "info": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/status/info/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/status/info/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/status/info/border/$value" } }
    },
    "success": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/status/success/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/status/success/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/status/success/border/$value" } }
    },
    "warning": {
      "fg": { "$type": "color", "$value": { "$ref": "#/color/status/warning/fg/$value" } },
      "bg": { "$type": "color", "$value": { "$ref": "#/color/status/warning/bg/$value" } },
      "border": { "$type": "color", "$value": { "$ref": "#/color/status/warning/border/$value" } }
    },
    "critical": {
