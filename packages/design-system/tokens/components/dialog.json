{
  "dialog": {
    "bg": { "$type": "color", "$value": { "$ref": "#/color/bg/elevated/$value" } },
    "fg": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
    "border": { "$type": "color", "$value": { "$ref": "#/color/border/default/$value" } },
    "shadow": { "$type": "shadow", "$value": { "$ref": "#/shadow/none/$value" } },
    "radius": { "$type": "dimension", "$value": { "$ref": "#/radius/lg/$value" } },
    "border-width": { "$type": "dimension", "$value": { "$ref": "#/border/width/$value" } },
    "padding": {
      "x": { "$type": "dimension", "$value": { "$ref": "#/space/overlay/padding/$value" } },
      "y": { "$type": "dimension", "$value": { "$ref": "#/space/overlay/padding/$value" } }
    },
    "gap": { "$type": "dimension", "$value": { "$ref": "#/space/overlay/gap/$value" } },
    "max-width": { "$type": "dimension", "$value": { "value": 32, "unit": "rem" } },
    "title": {
      "font": {
        "size": { "$type": "dimension", "$value": { "$ref": "#/font/size/4/$value" } },
        "weight": { "$type": "fontWeight", "$value": { "$ref": "#/font/weight/medium/$value" } }
      }
    },
    "motion": {
      "enter": { "$type": "duration", "$value": { "$ref": "#/motion/duration/normal/$value" } },
      "exit": { "$type": "duration", "$value": { "$ref": "#/motion/duration/fast/$value" } }
    }
  }
}
