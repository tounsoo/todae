      "bg": {
        "default": { "$type": "color", "$value": { "$ref": "#/color/bg/surface/$value" } },
        "hover": { "$type": "color", "$value": { "$ref": "#/color/bg/surface/$value" } },
        "active": { "$type": "color", "$value": { "$ref": "#/color/bg/canvas/$value" } },
        "focus": { "$type": "color", "$value": { "$ref": "#/color/bg/surface/$value" } },
        "disabled": { "$type": "color", "$value": { "$ref": "#/color/bg/surface/$value" } }
      },
      "fg": {
        "default": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
        "hover": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
        "active": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
        "focus": { "$type": "color", "$value": { "$ref": "#/color/fg/default/$value" } },
        "disabled": { "$type": "color", "$value": { "$ref": "#/color/fg/muted/$value" } }
