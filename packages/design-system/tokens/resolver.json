{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "todae",
  "version": "2025.10",
  "description": "Todae core, appearance, density, and seed component contract.",
  "sets": {
    "core": {
      "sources": [{ "$ref": "./core.json" }],
      "$extensions": { "dev.todae": { "layer": "core", "rules": ["reserved-roots"] } }
    },
    "focus": {
      "description": "Focus ring shared by every component; later contract entries read it",
      "sources": [{ "$ref": "./components/focus.json" }],
      "$extensions": { "dev.todae": { "layer": "contract", "rules": ["reserved-roots"] } }
    },
    "button": {
      "description": "Button geometry shared by every variant",
      "sources": [{ "$ref": "./components/button.base.json" }],
      "$extensions": { "dev.todae": { "layer": "contract", "rules": ["reserved-roots", "button"] } }
    },
    "contract": {
      "sources": [
        { "$ref": "./components/stack.json" },
        { "$ref": "./components/text.json" },
        { "$ref": "./components/prose.json" },
        { "$ref": "./components/field.json" },
        { "$ref": "./components/chip.json" },
        { "$ref": "./components/overlay.json" },
        { "$ref": "./components/dialog.json" },
        { "$ref": "./components/sheet.json" },
        { "$ref": "./components/popover.json" },
        { "$ref": "./components/tooltip.json" },
        { "$ref": "./components/option.json" },
        { "$ref": "./components/menu.json" },
        { "$ref": "./components/tabs.json" },
        { "$ref": "./components/selection.json" },
        { "$ref": "./components/alert.json" },
        { "$ref": "./components/empty-state.json" },
        { "$ref": "./components/toast.json" },
        { "$ref": "./components/fieldset.json" },
        { "$ref": "./components/link.json" },
        { "$ref": "./components/disclosure.json" },
        { "$ref": "./components/separator.json" },
        { "$ref": "./components/table.json" },
        { "$ref": "./components/progress.json" },
        { "$ref": "./components/slider.json" },
        { "$ref": "./components/badge.json" },
        { "$ref": "./components/card.json" },
        { "$ref": "./components/message.json" },
        { "$ref": "./components/conversation.json" },
        { "$ref": "./components/attachment.json" },
        { "$ref": "./components/steps.json" },
        { "$ref": "./components/breadcrumbs.json" },
        { "$ref": "./components/toolbar.json" },
        { "$ref": "./components/drawer.json" },
        { "$ref": "./components/loader.json" },
        { "$ref": "./components/skeleton.json" },
        { "$ref": "./components/code.json" },
        { "$ref": "./components/avatar.json" },
        { "$ref": "./components/grid.json" },
        { "$ref": "./components/pagination.json" },
        { "$ref": "./components/scroll.json" },
        { "$ref": "./components/tree.json" },
        { "$ref": "./components/nav.json" },
        { "$ref": "./components/picker.json" },
        { "$ref": "./components/calendar.json" }
      ],
      "$extensions": {
        "dev.todae": {
          "layer": "contract",
          "rules": ["reserved-roots", "button"],
          "slots": {
            "chip.bg": ["default", "hover", "focus", "disabled"],
            "chip.fg": ["default", "hover", "focus", "disabled"],
            "chip.border": ["default", "hover", "focus", "disabled"],
            "chip.ring": ["focus"],
            "field.border": ["default", "hover", "focus", "disabled", "invalid"],
            "field.ring": ["focus", "invalid"],
            "steps.fg": ["done", "current", "pending", "error"],
            "steps.marker.bg": ["done", "current", "pending", "error"],
            "steps.marker.fg": ["done", "current", "pending", "error"],
            "steps.marker.border": ["done", "current", "pending", "error"]
          },
          "contrast": [
            { "fg": "field.fg.default", "bg": "field.bg.default", "min": 75, "over": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] },
            { "fg": "field.fg.placeholder", "bg": "field.bg.default", "min": 60, "over": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] },
            { "fg": "field.fg.adornment", "bg": "field.bg.default", "min": 60, "over": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] },
            { "fg": "nav.item.fg.current", "bg": "nav.item.bg.current", "min": 60, "over": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] },
            { "fg": "option.fg.selected", "bg": "option.bg.selected", "min": 60, "over": ["popover.bg", "color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] },
            { "fg": "option.fg.selected", "bg": "option.bg.selected-highlighted", "min": 60, "over": ["popover.bg", "color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] },
            { "fg": "tree.item.fg.selected", "bg": "tree.item.bg.selected", "min": 60, "over": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.elevated"] }
          ]
        }
      }
    }
  },
  "modifiers": {
    "appearance": {
      "description": "Color appearance",
      "default": "light",
      "contexts": {
        "light": [{ "$ref": "./appearance/light.json" }],
        "dark": [{ "$ref": "./appearance/dark.json" }]
      },
      "$extensions": {
        "dev.todae": {
          "layer": "appearance",
          "rules": ["reserved-roots"],
          "attribute": "data-appearance",
          "root": true,
          "colorScheme": true,
          "contrast": [
            { "fg": "color.fg.default", "bg": "color.bg.canvas", "min": 75 },
            { "fg": "color.fg.default", "bg": "color.bg.surface", "min": 75 },
            { "fg": "color.fg.default", "bg": "color.bg.subtle", "min": 75 },
            { "fg": "color.fg.default", "bg": "color.bg.elevated", "min": 75 },
            { "fg": "color.fg.muted", "bg": "color.bg.canvas", "min": 60 },
            { "fg": "color.fg.muted", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.fg.muted", "bg": "color.bg.subtle", "min": 60 },
            { "fg": "color.fg.muted", "bg": "color.bg.elevated", "min": 60 },
            { "fg": "color.fg.placeholder", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.danger.default", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.danger.default", "bg": "color.bg.elevated", "min": 60 },
            { "fg": "color.on-accent", "bg": "color.accent.default", "min": 60 },
            { "fg": "color.on-accent", "bg": "color.accent.hover", "min": 60 },
            { "fg": "color.on-accent", "bg": "color.accent.active", "min": 60 },
            { "fg": "color.accent.default", "bg": "color.bg.canvas", "min": 45 },
            { "fg": "color.status.info.fg", "bg": "color.status.info.bg", "min": 75 },
            { "fg": "color.status.info.fg", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.status.success.fg", "bg": "color.status.success.bg", "min": 75 },
            { "fg": "color.status.success.fg", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.status.warning.fg", "bg": "color.status.warning.bg", "min": 75 },
            { "fg": "color.status.warning.fg", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.status.critical.fg", "bg": "color.status.critical.bg", "min": 75 },
            { "fg": "color.status.critical.fg", "bg": "color.bg.surface", "min": 60 },
            { "fg": "color.category.1.fg", "bg": "color.category.1.bg", "min": 75 },
            { "fg": "color.category.2.fg", "bg": "color.category.2.bg", "min": 75 },
            { "fg": "color.category.3.fg", "bg": "color.category.3.bg", "min": 75 },
            { "fg": "color.category.4.fg", "bg": "color.category.4.bg", "min": 75 },
            { "fg": "color.category.5.fg", "bg": "color.category.5.bg", "min": 75 },
            { "fg": "color.category.6.fg", "bg": "color.category.6.bg", "min": 75 },
            { "fg": "color.category.7.fg", "bg": "color.category.7.bg", "min": 75 },
            { "fg": "color.category.8.fg", "bg": "color.category.8.bg", "min": 75 }
          ]
        }
      }
    },
    "density": {
      "description": "Spacing density",
      "default": "comfortable",
      "contexts": {
        "compact": [{ "$ref": "./density/compact.json" }],
        "comfortable": [{ "$ref": "./density/comfortable.json" }],
        "spacious": [{ "$ref": "./density/spacious.json" }]
      },
      "$extensions": {
        "dev.todae": { "layer": "density", "rules": ["reserved-roots", "density-space"], "attribute": "data-density", "root": true }
      }
    },
    "buttonVariant": {
      "description": "Button variant value sets",
      "default": "primary",
      "contexts": {
        "primary": [{ "$ref": "./components/button.primary.json" }],
        "secondary": [{ "$ref": "./components/button.secondary.json" }],
        "ghost": [{ "$ref": "./components/button.ghost.json" }]
      },
      "$extensions": {
        "dev.todae": {
          "layer": "contract",
          "rules": ["reserved-roots", "button"],
          "attribute": "data-button-variant",
          "alias": true
        }
      }
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/core" },
    { "$ref": "#/modifiers/appearance" },
    { "$ref": "#/modifiers/density" },
    { "$ref": "#/sets/focus" },
    { "$ref": "#/sets/button" },
    { "$ref": "#/modifiers/buttonVariant" },
    { "$ref": "#/sets/contract" }
  ]
}
