  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 0.125, "unit": "rem" } },
    "md": { "$type": "dimension", "$value": { "value": 0.3125, "unit": "rem" } },
    "lg": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } }
  },
  "font": {
    "size": {
      "1": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
      "2": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "3": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "4": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "5": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
      "6": { "$type": "dimension", "$value": { "value": 1.875, "unit": "rem" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 600 }
    },
    "letter-spacing": {
      "default": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
    },
    "text-transform": {
      "none": { "$type": "textTransform", "$value": "none" }
    },
    "leading": {
      "default": { "$type": "number", "$value": 1.5 },
      "tight": { "$type": "number", "$value": 1.25 }
    },
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "Segoe UI", "Roboto", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } },
      "normal": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
      "moderate": { "$type": "duration", "$value": { "value": 240, "unit": "ms" } },
      "slow": { "$type": "duration", "$value": { "value": 280, "unit": "ms" } },
      "slower": { "$type": "duration", "$value": { "value": 300, "unit": "ms" } }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
    }
  },
  "opacity": {
    "8": { "$type": "number", "$value": 0.08 },
    "10": { "$type": "number", "$value": 0.1 },
    "12": { "$type": "number", "$value": 0.12 },
    "14": { "$type": "number", "$value": 0.14 },
    "16": { "$type": "number", "$value": 0.16 },
    "20": { "$type": "number", "$value": 0.2 },
    "28": { "$type": "number", "$value": 0.28 },
    "45": { "$type": "number", "$value": 0.45 },
    "70": { "$type": "number", "$value": 0.7 }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 0, "unit": "px" },
        "blur": { "value": 0, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
