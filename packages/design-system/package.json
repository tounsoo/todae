{
  "name": "@tounsoo/todae",
  "version": "0.11.2",
  "description": "A low-level React design system to build a company design system on: components, headless hooks and DTCG design tokens.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "dtcg",
    "css"
  ],
  "license": "MIT",
  "homepage": "https://todae.omsoo.design",
  "bugs": {
    "url": "https://github.com/tounsoo/todae/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tounsoo/todae.git",
    "directory": "packages/design-system"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "todae-tokens": "./dist/scripts/build-tokens.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stack": {
      "types": "./dist/server/stack.d.ts",
      "default": "./dist/stack.js"
    },
    "./text": {
      "types": "./dist/server/text.d.ts",
      "default": "./dist/text.js"
    },
    "./label": {
      "types": "./dist/server/label.d.ts",
      "default": "./dist/label.js"
    },
    "./badge": {
      "types": "./dist/server/badge.d.ts",
      "default": "./dist/badge.js"
    },
    "./empty-state": {
      "types": "./dist/server/empty-state.d.ts",
      "default": "./dist/empty-state.js"
    },
    "./card": {
      "types": "./dist/server/card.d.ts",
      "default": "./dist/card.js"
    },
    "./data-list": {
      "types": "./dist/server/data-list.d.ts",
      "default": "./dist/data-list.js"
    },
    "./message": {
      "types": "./dist/server/message.d.ts",
      "default": "./dist/message.js"
    },
    "./breadcrumbs": {
      "types": "./dist/server/breadcrumbs.d.ts",
      "default": "./dist/breadcrumbs.js"
    },
    "./grid": {
      "types": "./dist/server/grid.d.ts",
      "default": "./dist/grid.js"
    },
    "./pagination": {
      "types": "./dist/server/pagination.d.ts",
      "default": "./dist/pagination.js"
    },
    "./link": {
      "types": "./dist/server/link.d.ts",
      "default": "./dist/link.js"
    },
    "./disclosure": {
      "types": "./dist/server/disclosure.d.ts",
      "default": "./dist/disclosure.js"
    },
    "./separator": {
      "types": "./dist/server/separator.d.ts",
      "default": "./dist/separator.js"
    },
    "./prose": {
      "types": "./dist/server/prose.d.ts",
      "default": "./dist/prose.js"
    },
    "./table": {
      "types": "./dist/server/table.d.ts",
      "default": "./dist/table.js"
    },
    "./progress": {
      "types": "./dist/server/progress.d.ts",
      "default": "./dist/progress.js"
    },
    "./meter": {
      "types": "./dist/server/meter.d.ts",
      "default": "./dist/meter.js"
    },
    "./loader": {
      "types": "./dist/server/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./skeleton": {
      "types": "./dist/server/skeleton.d.ts",
      "default": "./dist/skeleton.js"
    },
    "./slider": {
      "types": "./dist/server/slider.d.ts",
      "default": "./dist/slider.js"
    },
    "./code": {
      "types": "./dist/server/code.d.ts",
      "default": "./dist/code.js"
    },
    "./code-block": {
      "types": "./dist/server/code-block.d.ts",
      "default": "./dist/code-block.js"
    },
    "./kbd": {
      "types": "./dist/server/kbd.d.ts",
      "default": "./dist/kbd.js"
    },
    "./visually-hidden": {
      "types": "./dist/server/visually-hidden.d.ts",
      "default": "./dist/visually-hidden.js"
    },
    "./todae.css": "./dist/todae.css",
    "./dist/todae.css": "./dist/todae.css",
    "./schema/components.json": "./schema/components.json",
    "./tokens.json": "./tokens/tokens.generated.json",
    "./tokens-builder": {
      "types": "./dist/scripts/tokens-builder.d.ts",
      "default": "./dist/scripts/tokens-builder.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "tokens",
    "!tokens/api-approved-removals.json",
    "!tokens/name-grandfather.json",
    "!tokens/name-schema.json"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-own-tokens.ts",
    "tokens:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/package-tokens.ts --check",
    "tokens:grandfather": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/package-tokens.ts --write-grandfather",
    "tokens:api:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-token-api.ts",
    "tokens:consumers": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/token-consumers.ts",
    "build": "pnpm tokens && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "prepack": "pnpm build",
    "dev": "vite build --watch",
    "schema": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-schema.ts",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "^4.13.0",
    "esbuild": "0.25.12",
    "jsdom": "^31.0.0",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
