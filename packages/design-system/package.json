{
  "name": "@tounsoo/todae",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "todae-tokens": "./dist/scripts/build-tokens.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stack": {
      "types": "./dist/server/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./text": {
      "types": "./dist/server/text.d.ts",
      "import": "./dist/text.js"
    },
    "./label": {
      "types": "./dist/server/label.d.ts",
      "import": "./dist/label.js"
    },
    "./todae.css": "./dist/todae.css",
    "./schema/components.json": "./schema/components.json",
    "./tokens.json": "./tokens/tokens.generated.json",
    "./tokens-builder": {
      "types": "./dist/scripts/build-tokens.d.ts",
      "import": "./dist/scripts/build-tokens.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "tokens"
  ],
  "scripts": {
    "tokens": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-tokens.ts self",
    "tokens:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-tokens.ts self --check",
    "build": "pnpm tokens && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "dev": "vite build --watch",
    "schema": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-schema.ts",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/browser": "3.2.7",
    "jsdom": "^26.0.0",
    "playwright": "1.56.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
