{
  "name": "todae",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "8.5.31"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "mcp-handler>@modelcontextprotocol/sdk": "1.32.1"
      }
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:ds": "pnpm --filter @tounsoo/todae build",
    "publish:check": "bash scripts/publish-check.sh",
    "dev:ds": "pnpm --filter @tounsoo/todae dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev": "pnpm dev:docs",
    "schema": "pnpm --filter @tounsoo/todae schema",
    "tokens": "pnpm --filter @tounsoo/todae tokens",
    "tokens:check": "pnpm --filter @tounsoo/todae tokens:check",
    "test": "pnpm -r --if-present test",
    "test:browser": "pnpm -r --if-present test:browser",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "graft:build": "npx -y @nanonets/graft@0.18.0 build",
    "graft:check": "npx -y @nanonets/graft@0.18.0 check",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "typescript-eslint": "^8.71.0"
  }
}
