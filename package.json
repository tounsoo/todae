{
  "name": "todae",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:ds": "pnpm --filter @todae/design-system build",
    "dev:ds": "pnpm --filter @todae/design-system dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev": "pnpm dev:docs",
    "schema": "pnpm --filter @todae/design-system schema",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  }
}
