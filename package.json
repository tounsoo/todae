{
  "name": "todae",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:ds": "pnpm --filter @omsoo/todae build",
    "dev:ds": "pnpm --filter @omsoo/todae dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev": "pnpm dev:docs",
    "schema": "pnpm --filter @omsoo/todae schema",
    "tokens": "pnpm --filter @omsoo/todae tokens",
    "tokens:check": "pnpm --filter @omsoo/todae tokens:check",
    "test": "pnpm -r --if-present test && node --test '.githooks/*.test.mjs'",
    "test:browser": "pnpm -r --if-present test:browser",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "graft:build": "npx -y @nanonets/graft@0.18.0 build",
    "graft:check": "npx -y @nanonets/graft@0.18.0 check",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0"
  }
}
