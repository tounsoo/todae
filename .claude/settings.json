{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/.claude\" && { grep -qx 'session hook: off' pstack-models.md || cat pstack-session-start.md; }"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/update-pstack.sh --brief",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
