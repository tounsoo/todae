{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "tounsoo/todae",
      "template": "\n\n- {summary} {ref}"
    }
  ],
  "commit": false,
  "format": false,
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "changedFilePatterns": [
    "**",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/__snapshots__/**",
    "!**/__fixtures__/**",
    "!src/test/**",
    "!vitest.browser.config.ts",
    "!scripts/browser-results-reporter.ts",
    "!scripts/check-token-api.ts",
    "!scripts/firefox-quarantine.ts",
    "!scripts/meta-types.ts",
    "!scripts/package-tokens.ts",
    "!scripts/token-consumers.ts",
    "!scripts/tokens/consumers.ts",
    "!scripts/tokens/names.ts",
    "!tokens/api-approved-removals.json",
    "!tokens/name-grandfather.json",
    "!tokens/name-schema.json",
    "!CHANGELOG.md"
  ]
}
