{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "omsoo-design/todae"
    }
  ],
  "commit": false,
  "format": false,
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "changedFilePatterns": [
    "**",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!src/test/**",
    "!vitest.browser.config.ts"
  ]
}
